        "user": {
          "description": "Sign in at https://accounts.google.com/EmbeddedSetup with the Google account that manages your Wifi network, then copy the full value of the 'oauth_token' cookie (starts with oauth2_4/). You may also paste a master token (starts with aas_et/ or oauth2rt_1/).",
          "data": {
            "email": "Google account email",
            "oauth_token": "OAuth or master token",
            "add_disabled": "Add all entities as enabled?"
          }
        },
        "reauth_confirm": {
          "description": "Your Google Wifi credentials are no longer valid. Sign in at https://accounts.google.com/EmbeddedSetup, copy the 'oauth_token' cookie value and paste it below.",
